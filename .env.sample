# === Cau hinh backend ===

# Loai database: sqlite | supabase
DB_TYPE=sqlite

# Duong dan SQLite (chi dung khi DB_TYPE=sqlite)
DATABASE_URL=file:./dev.db

# JWT secret — doi thanh chuoi ngau nhien dai khi deploy
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Port
PORT=3000

# ==== Supabase (chi dung khi DB_TYPE=supabase) ====
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
